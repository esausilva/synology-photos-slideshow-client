{
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ES2022",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "paths": {
      "~/*": ["./src/*"],
      //"@/component/*": ["app/components/*"],
    },
  },
  "exclude": [
    "node_modules"
  ],
  "include": [
    "**/*.ts", 
    "**/*.tsx",
    "src/types/**/*.d.ts"
  ],
}
