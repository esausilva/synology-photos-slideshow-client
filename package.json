{
  "name": "synology-photos-slideshow-client",
  "version": "1.0.0",
  "description": "A responsive web application designed to display random image slideshows sourced from a Synology NAS. Built to pair seamlessly with my Synology Photos Slideshow API.",
  "type": "module",
  "scripts": {
    "dev": "NODE_TLS_REJECT_UNAUTHORIZED=0 vite dev",
    "build": "vite build && tsc --noEmit",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview"
  },
  "keywords": [],
  "author": "Esau Silva (https://github.com/esausilva)",
  "license": "GPL-3.0",
  "packageManager": "pnpm@10.26.1",
  "dependencies": {
    "@tanstack/react-router": "^1.144.0",
    "@tanstack/react-router-devtools": "^1.144.0",
    "@tanstack/react-start": "^1.145.3",
    "nitro": "3.0.1-alpha.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "browserslist": "^4.28.1",
    "lightningcss": "^1.30.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-css-modules": "^1.12.0",
    "vite-tsconfig-paths": "^6.0.3"
  }
