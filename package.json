{
  "name": "synology-photos-slideshow-client",
  "version": "1.0.0",
  "description": "A responsive web application designed to display random image slideshows sourced from a Synology NAS. Built to pair seamlessly with my Synology Photos Slideshow API.",
  "type": "module",
  "scripts": {
    "dev": "NODE_TLS_REJECT_UNAUTHORIZED=0 vite dev",
    "build": "vite build && tsc --noEmit",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview"
  },
  "keywords": [],
